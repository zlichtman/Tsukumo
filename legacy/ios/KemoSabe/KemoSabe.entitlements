<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Sign in with Apple plus account sync through the person's private iCloud database. Used only
     when both KEMO_SIGN_IN_WITH_APPLE and KEMO_ICLOUD_SYNC are YES (ios/project.yml), after the
     iCloud container iCloud.com.zlichtman.kemosabe exists and is assigned to the App ID
     com.zlichtman.kemosabe. Push is for CloudKit's silent change notifications only.
     See design/ACCOUNTS-AND-PROFILES.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
	<key>com.apple.developer.icloud-container-identifiers</key>
	<array>
		<string>iCloud.com.zlichtman.kemosabe</string>
	</array>
	<key>com.apple.developer.icloud-services</key>
	<array>
		<string>CloudKit</string>
	</array>
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
