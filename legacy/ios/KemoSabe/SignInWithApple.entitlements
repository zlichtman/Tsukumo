<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Used only when the build setting KEMO_SIGN_IN_WITH_APPLE is YES (ios/project.yml), after the
     App ID com.zlichtman.kemosabe has the Sign in with Apple capability and its provisioning
     profiles are regenerated. With KEMO_ICLOUD_SYNC also YES, KemoSabe.entitlements (this plus
     iCloud) is used instead; see design/ACCOUNTS-AND-PROFILES.md. -->
<plist version="1.0">
<dict>
	<key>com.apple.developer.applesignin</key>
	<array>
		<string>Default</string>
	</array>
</dict>
</plist>
