<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
<key>NSAppTransportSecurity</key><dict><key>NSAllowsLocalNetworking</key><true/></dict>
<key>NSLocalNetworkUsageDescription</key><string>KemoSabe uses the local network when you start Nearby, chat with Claude through your paired Mac on the same Wi‑Fi, or send a message to a model connection you configured. Both people approve nearby pairing.</string>
<key>NSBonjourServices</key><array><string>_kemosabe-peer._tcp</string><string>_kemosabe-peer._udp</string><string>_kemosabe-relay._tcp</string></array>
<key>NSAlarmKitUsageDescription</key><string>KemoSabe schedules wake-up alarms only after you review and approve the exact time.</string>
<key>BGTaskSchedulerPermittedIdentifiers</key><array><string>com.zlichtman.kemosabe.routine-refresh</string></array>
<key>UIBackgroundModes</key><array><string>audio</string><string>fetch</string><string>remote-notification</string></array>
<key>NSSupportsLiveActivities</key><true/>
<key>CKSharingSupported</key><true/>
<key>CFBundleURLTypes</key><array><dict><key>CFBundleURLName</key><string>com.zlichtman.kemosabe</string><key>CFBundleURLSchemes</key><array><string>kemosabe</string></array></dict></array>
<key>KemoSignInWithApple</key><string>$(KEMO_SIGN_IN_WITH_APPLE)</string>
<key>KemoICloudSync</key><string>$(KEMO_ICLOUD_SYNC)</string>
<key>KemoPrivateCloud</key><string>$(KEMO_PRIVATE_CLOUD)</string>
</dict></plist>
