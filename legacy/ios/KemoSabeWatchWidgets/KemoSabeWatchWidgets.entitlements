<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyLists/1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Kemo's pet meters, shared by the watch app and its complication (KemoVitalsMirror).
	     A team keychain group needs no developer-portal setup, unlike an App Group. -->
	<key>keychain-access-groups</key>
	<array>
		<string>$(AppIdentifierPrefix)com.zlichtman.kemosabe.watchkitapp.pet</string>
	</array>
</dict>
</plist>
